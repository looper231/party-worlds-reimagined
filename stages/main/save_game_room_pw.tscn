[sub_resource type="GDScript" id="GDScript_u665y"]
script/source = "extends Label

func _ready() -> void:
	update_text()

func update_text() -> void:
	if CustomGlobals.check_for_hatate_boss():
		text = \"double spoiler:\\nhatate himekaidou\"
	else:
		text = \"double spoiler:\\naya shameimaru\"

func toggle_boss() -> void:
	CustomGlobals.w9_alt_boss = !CustomGlobals.w9_alt_boss
	update_text()
"

