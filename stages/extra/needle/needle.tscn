[sub_resource type="GDScript" id="GDScript_aumoq"]
script/source = "extends \"res://addons/secrets_manager/secret_unlocker.gd\"

func needle_level_secret() -> void:
	unlock_secret(0)
	if Data.values.lives >= -30:
		unlock_secret(2)
		if Data.values.lives >= 0: unlock_secret(1)
"

